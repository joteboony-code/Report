# Copy this file to .env and fill in real values.

# Dashboard web server. Keep host as 127.0.0.1 for local-only use.
# Use 0.0.0.0 only when deploying behind HTTPS and a firewall/reverse proxy.
EDMS_DASHBOARD_HOST=127.0.0.1
EDMS_DASHBOARD_PORT=8765

# Required before exposing the dashboard publicly.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Option A: use a cookie from the logged-in EDMS browser session, for example:
# laravel_session=...; XSRF-TOKEN=...
EDMS_COOKIE=

# Option B: let the script log in to EDMS.
# The script only fills the login form. It must never fill registration/sign-up data.
EDMS_USERNAME=
EDMS_PASSWORD=

# Optional. Default comes from the EDMS login form action.
EDMS_LOGIN_URL=https://www.castles-th.com/login

# LINE Messaging API long-lived channel access token from LINE Developers.
LINE_CHANNEL_ACCESS_TOKEN=

# Recipient ID: userId, groupId, or roomId that the bot can push to.
LINE_TO=

# true = daily automation is allowed to log in, check jobs, and send LINE.
EDMS_ALERT_ENABLED=true

# Daily LINE push time in Bangkok time. The dashboard process must be running.
ALERT_TIME=07:00

# true = send only jobs whose Plan Date is today in Bangkok time.
ONLY_TODAY=true

# true = send a message even when there is no job today.
NOTIFY_WHEN_EMPTY=true
